# Copy this file to .env (not versioned) and fill in the values.
# Avoid accented characters in values here (file is read as ISO-8859-1): set them on Render instead.
# In production (Render), set the same variables in the service dashboard.

# --- MongoDB (MongoDB Atlas: Database > Connect > Drivers)  --------------------
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/clinic?retryWrites=true&w=majority

# --- Security ------------------------------------------------------------------
# Long random string (e.g. openssl rand -base64 48)
JWT_SECRET=
JWT_EXPIRATION_HOURS=72

# --- Resend (https://resend.com/api-keys) ---------------------------------------
RESEND_API_KEY=
# Sender on a domain verified in Resend. "onboarding@resend.dev" can only email the Resend account owner.
# MAIL_FROM=Display Name <contact@your-domain.com>   (default: "Clinique Badri <onboarding@resend.dev>")
# Doctor address(es) receiving notifications (comma-separated)
DOCTOR_NOTIFICATION_EMAIL=

# --- URLs ------------------------------------------------------------------------
# Public frontend URL (used for links in emails)
FRONTEND_URL=http://localhost:4200
# Allowed CORS origins, comma-separated. Wildcards allowed: https://*.my-project.pages.dev
ALLOWED_ORIGINS=http://localhost:4200

# --- Clinic ------------------------------------------------------------------------
# CLINIC_NAME=...   (default: "Clinique Badri")
CLINIC_TIME_ZONE=Europe/Paris

# --- Accounts created on first startup (if missing) ------------------------------
ADMIN_EMAIL=admin@clinique-badri.fr
ADMIN_PASSWORD=
DOCTOR_EMAIL=docteur@clinique-badri.fr
DOCTOR_PASSWORD=
DOCTOR_FIRST_NAME=Camille
DOCTOR_LAST_NAME=Laurent

# true = create fake patients / appointments / messages when the database has no patient
SEED_DEMO_DATA=false
